# Dockerfile.cuda — GPU-варианты up-and-run-stt: тот же код и тот же ONNX-движок,
# что в CPU-образе (Dockerfile), но инференс через CUDAExecutionProvider
# (onnxruntime-gpu). Один Dockerfile, два варианта через build-аргументы:
#
#   cuda13 (по умолчанию)  — CUDA 13.0 + cuDNN 9, onnxruntime-gpu с PyPI.
#       GPU: Turing и новее (RTX 20/30/40/50, T4, A/H-серии, DGX Spark / GB10).
#       Драйвер: 580+. Архитектуры образа: amd64 и arm64.
#   cuda12                 — CUDA 12.8 + cuDNN 9, onnxruntime-gpu из фида ORT под CUDA 12.
#       GPU: Pascal и новее (GTX 10xx, 16xx, RTX 20/30/40/50, P100/V100 …) —
#       CUDA 13 выбросила Pascal/Volta, а таких карт у людей больше всего.
#       Драйвер: 525+ (minor-version совместимость CUDA 12.x). Только amd64:
#       aarch64-сборок ORT под CUDA 12 нет, старые GeForce живут на x86.
#       ./build.sh --cuda12, или вручную:
#         docker build -f Dockerfile.cuda \
#           --build-arg CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04 \
#           --build-arg ORT_GPU_VERSION=1.29.0 \
#           --build-arg ORT_INDEX_URL=https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/ .
#
# Опубликованные теги: X.Y.Z-cuda12 / cuda12 и X.Y.Z-cuda13 / cuda13. Алиаса
# `cuda` нет намеренно: какая версия CUDA нужна — определяется картой и
# драйвером, и это должен выбрать тот, кто ставит образ.
#
# Отличия от Dockerfile (CPU):
#   - база nvidia/cuda ...-cudnn-runtime вместо python:slim (отсюда 4–6 ГБ размера);
#   - вместо onnxruntime ставится onnxruntime-gpu (пакеты взаимоисключающи:
#     делят top-level `onnxruntime`, поэтому CPU-пакет удаляется явно);
#   - DEVICE=cuda: сервис падает на старте, если GPU не виден, а не работает
#     молча на CPU (DEVICE=auto — работать на CPU, если GPU нет; так CI гоняет
#     тесты этих образов на раннерах без GPU).
#
# Запуск: docker run --gpus all --ipc=host ... (см. docker-compose.yml, профили
# cuda12 / cuda13). На машинах с единой памятью (DGX Spark) обязательно
# CUDA_MEM_LIMIT_MB — cgroup-лимиты Docker GPU-аллокации не ловят, а
# переполнение вешает хост.

ARG CUDA_IMAGE=nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04

# ============================ builder =================================
FROM ${CUDA_IMAGE} AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.3 /uv /bin/uv

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./

# Тот же лок, что у CPU-образа (все версии совпадают), затем подмена
# onnxruntime -> onnxruntime-gpu. Версия GPU-пакета прибита: она определяет
# требования к CUDA/cuDNN и набор поддерживаемых архитектур GPU.
ARG ORT_GPU_VERSION=1.30.0
# Пустой ORT_INDEX_URL = PyPI (CUDA 13); для CUDA 12 — фид ORT (см. шапку)
ARG ORT_INDEX_URL=""
RUN uv sync --frozen --no-dev --no-install-project \
    && uv pip uninstall onnxruntime \
    && uv pip install ${ORT_INDEX_URL:+--index-url "$ORT_INDEX_URL"} "onnxruntime-gpu==${ORT_GPU_VERSION}"

# ============================ runtime =================================
FROM ${CUDA_IMAGE}

ARG VERSION=dev
ARG REVISION=unknown
ARG CREATED=""
LABEL org.opencontainers.image.title="up-and-run-stt-cuda" \
      org.opencontainers.image.description="Local Russian speech-to-text service (GigaAM, ONNX Runtime, CUDA) with an OpenAI-compatible API" \
      org.opencontainers.image.source="https://github.com/vvpreo/up-and-run-stt" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INFERENCE_BACKEND=onnx \
    DEVICE=cuda \
    GIGAAM_MODELS=v3_e2e_ctc \
    DEFAULT_LANGUAGE=ru \
    MODEL_CACHE_DIR=/app/data \
    PATH="/app/.venv/bin:$PATH" \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Forward-compat пакет CUDA (/usr/local/cuda/compat) удаляется. Container
# Toolkit подставляет его, когда драйвер хоста старше рантайма образа, но
# работает это только на датацентровых GPU; на GeForce получается
# «CUDA failure 804: forward compatibility was attempted on non supported HW»,
# хотя обычная minor-version совместимость (драйвер 525+ для любого CUDA 12.x,
# 580+ для 13.x) там прекрасно работает. Целевая аудитория GPU-образов —
# именно GeForce, поэтому одно простое правило про минимальный драйвер лучше
# «иногда работающего» compat-пакета.
RUN rm -rf /usr/local/cuda/compat

COPY --from=mwader/static-ffmpeg:7.1 /ffmpeg /usr/local/bin/ffmpeg
RUN ffmpeg -version | head -1

# uid 1000 в ubuntu:24.04 уже занят пользователем `ubuntu` — переименовываем
# его, чтобы совпадать с CPU-образом и правами на томе с весами.
RUN usermod -l app -d /home/app -m ubuntu && groupmod -n app ubuntu \
    && usermod -s /usr/sbin/nologin app

WORKDIR /app

# Скачивание с ретраями: HF время от времени отвечает 503, и разовый сбой
# не должен ронять сборку (так упал dry-run релиза на cuda13/arm64).
RUN mkdir -p /app/vad \
    && for i in 1 2 3 4 5 6; do \
         python3 -c "import urllib.request; urllib.request.urlretrieve('https://huggingface.co/vvpreo/gigaam-v3-onnx/resolve/main/silero_vad.onnx', '/app/vad/silero_vad.onnx')" && break; \
         echo "silero_vad download attempt $i failed, retrying"; sleep $((i * 5)); \
       done \
    && test -s /app/vad/silero_vad.onnx \
    && chown -R app:app /app/vad

COPY --from=builder --chown=app:app /app/.venv /app/.venv
COPY --chown=app:app src/ /app/src/
COPY --chown=app:app main.py /app/

RUN mkdir -p /app/data && chown app:app /app/data && chmod 755 /app/data

USER app
EXPOSE 9007

# Базовый образ NVIDIA ставит entrypoint, печатающий лицензионный баннер при
# каждом старте — в логах сервиса и в stdout любых `docker run ... python3`
# это только мусор. Сбрасываем.
ENTRYPOINT []

HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:9007/health')" || exit 1

CMD ["python3", "main.py"]
